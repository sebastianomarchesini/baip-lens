{
  "name": "baip-lens-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @baip-lens/ui && npm run build -w baip-lens",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sample": "npm run sample -w baip-lens",
    "coverage": "npm run coverage -w baip-lens",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "micromatch": "npm:picomatch@^4.0.7"
  }
}
